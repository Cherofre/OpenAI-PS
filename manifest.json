{
  "id": "com.wuji419-bit.openai-ps",
  "name": "OpenAI PS",
  "version": "0.1.0",
  "manifestVersion": 4,
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "22.0"
  },
  "requiredPermissions": {
    "network": {
      "domains": "all"
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "openaiPsPanel",
      "label": {
        "default": "OpenAI PS"
      },
      "minimumSize": {
        "width": 320,
        "height": 460
      },
      "maximumSize": {
        "width": 900,
        "height": 1200
      },
      "preferredDockedSize": {
        "width": 360,
        "height": 620
      },
      "preferredFloatingSize": {
        "width": 380,
        "height": 680
      }
    }
  ]
}
